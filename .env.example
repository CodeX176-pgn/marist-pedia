# Marist Pedia environment configuration.
# Copy this file to .env and replace the example values.

# Runtime mode.
# Use "development" locally and "production" on the server.
MARIST_ENVIRONMENT=development

# Enable application debugging only when appropriate.
MARIST_DEBUG=false

# Server binding.
MARIST_HOST=0.0.0.0
MARIST_PORT=8000

# Number of Uvicorn workers.
# Keep this at 1 when using SQLite.
MARIST_WORKERS=1

# Websites allowed to make browser requests to the API.
MARIST_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Hosts accepted by FastAPI.
MARIST_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Teacher/admin secret.
# Replace this with a long random value.
MARIST_ADMIN_KEY=replace-with-a-long-random-key

# Swagger/ReDoc/OpenAPI.
# Set this to false for a production deployment if desired.
MARIST_DOCS_ENABLED=true

# Database.
# SQLite is the default.
#
# MARIST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/marist_pedia

# Upload limits.
MARIST_MAX_UPLOAD_SIZE=10485760
MARIST_MAX_FILENAME_LENGTH=255

# Question generator.
MARIST_QUESTION_GENERATOR=local